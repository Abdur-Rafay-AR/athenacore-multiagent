# Crucible configuration.
# Copy to .env and edit. Every value here is the default, so an empty .env works.
# Any variable can also be set in the environment; the environment wins.

# ─── Model ──────────────────────────────────────────────────────────────────
# Format: provider:model
#   ollama:llama3.1              local, free, private (default)
#   openai:gpt-4o-mini           or any OpenAI-compatible endpoint
#   anthropic:claude-sonnet-4-5
#   groq:llama-3.3-70b           alias with a preconfigured base URL
#   echo:test                    deterministic and offline, for tests/demos
CRUCIBLE_MODEL=ollama:llama3.1

CRUCIBLE_TEMPERATURE=0.4
CRUCIBLE_MAX_OUTPUT_TOKENS=1024
CRUCIBLE_REQUEST_TIMEOUT_S=120
CRUCIBLE_MAX_RETRIES=3
CRUCIBLE_RETRY_BACKOFF_S=1.5

# ─── Provider endpoints and credentials ─────────────────────────────────────
CRUCIBLE_OLLAMA_HOST=http://localhost:11434

# Point this at any OpenAI-compatible server (vLLM, LM Studio, llama.cpp, ...).
CRUCIBLE_OPENAI_BASE_URL=https://api.openai.com/v1
# CRUCIBLE_OPENAI_API_KEY=sk-...

CRUCIBLE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# CRUCIBLE_ANTHROPIC_API_KEY=sk-ant-...

# ─── Storage ────────────────────────────────────────────────────────────────
CRUCIBLE_DATA_DIR=data
CRUCIBLE_DATABASE_PATH=data/crucible.sqlite3

# ─── Memory behaviour ───────────────────────────────────────────────────────
# Max tokens of recalled memory injected into a single prompt.
CRUCIBLE_CONTEXT_TOKEN_BUDGET=6000

# Once a topic's live entries exceed this, the oldest are folded into a durable
# summary and archived. Archived entries are never deleted and can be restored.
CRUCIBLE_COMPACTION_THRESHOLD_TOKENS=12000
CRUCIBLE_COMPACTION_KEEP_RECENT=8

CRUCIBLE_EMBEDDINGS_ENABLED=true
CRUCIBLE_EMBEDDING_DIMS=256

# ─── Retrieval ranking ──────────────────────────────────────────────────────
# The four signals blended into a recall score. Each is normalised to [0,1]
# across the candidate set, so these weights mean relative importance.
# Tuning these is the highest-leverage change you can make; inspect the effect
# with:  crucible recall "query" --topic t --explain
CRUCIBLE_RECALL_W_KEYWORD=1.0     # BM25 full-text relevance
CRUCIBLE_RECALL_W_SEMANTIC=1.0    # embedding cosine similarity
CRUCIBLE_RECALL_W_RECENCY=0.6     # exponential decay by age
CRUCIBLE_RECALL_W_SALIENCE=0.4    # per-entry importance

CRUCIBLE_RECALL_MAX_ENTRIES=12
CRUCIBLE_RECALL_CANDIDATES=60     # rows scored before ranking
CRUCIBLE_RECALL_HALF_LIFE_H=72    # hours at which recency halves

# Maximal Marginal Relevance: 1.0 = pure relevance, 0.0 = maximum diversity.
# Lower it when agents keep recalling paraphrases of the same point.
CRUCIBLE_RECALL_MMR_LAMBDA=0.7

CRUCIBLE_RECALL_INCLUDE_ARCHIVED=false

# ─── Orchestration ──────────────────────────────────────────────────────────
CRUCIBLE_MAX_PARALLEL_AGENTS=4

CRUCIBLE_DEBATE_ROUNDS=3
# Cosine similarity between consecutive debate rounds above which positions are
# considered settled and the debate stops early.
CRUCIBLE_DEBATE_CONVERGENCE=0.92

CRUCIBLE_TOOLS_ENABLED=true
CRUCIBLE_MAX_TOOL_CALLS=4

# Network egress is opt-in. Needs: pip install 'crucible-agents[search]'
CRUCIBLE_WEB_SEARCH_ENABLED=false

# ─── Logging ────────────────────────────────────────────────────────────────
CRUCIBLE_LOG_LEVEL=INFO
CRUCIBLE_LOG_JSON=false

# AthenaCore configuration.
# Copy to .env and edit. Every value here is the default, so an empty .env works.
# Any variable can also be set in the environment; the environment wins.

# ─── Model ──────────────────────────────────────────────────────────────────
# Format: provider:model
#   ollama:llama3.1              local, free, private (default)
#   openai:gpt-4o-mini           or any OpenAI-compatible endpoint
#   anthropic:claude-sonnet-4-5
#   groq:llama-3.3-70b           alias with a preconfigured base URL
#   echo:test                    deterministic and offline, for tests/demos
ATHENA_MODEL=ollama:llama3.1

ATHENA_TEMPERATURE=0.4
ATHENA_MAX_OUTPUT_TOKENS=1024
ATHENA_REQUEST_TIMEOUT_S=120
ATHENA_MAX_RETRIES=3
ATHENA_RETRY_BACKOFF_S=1.5

# ─── Provider endpoints and credentials ─────────────────────────────────────
ATHENA_OLLAMA_HOST=http://localhost:11434

# Point this at any OpenAI-compatible server (vLLM, LM Studio, llama.cpp, ...).
ATHENA_OPENAI_BASE_URL=https://api.openai.com/v1
# ATHENA_OPENAI_API_KEY=sk-...

ATHENA_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ATHENA_ANTHROPIC_API_KEY=sk-ant-...

# ─── Storage ────────────────────────────────────────────────────────────────
ATHENA_DATA_DIR=data
ATHENA_DATABASE_PATH=data/athenacore.sqlite3

# ─── Memory behaviour ───────────────────────────────────────────────────────
# Max tokens of recalled memory injected into a single prompt.
ATHENA_CONTEXT_TOKEN_BUDGET=6000

# Once a topic's live entries exceed this, the oldest are folded into a durable
# summary and archived. Archived entries are never deleted and can be restored.
ATHENA_COMPACTION_THRESHOLD_TOKENS=12000
ATHENA_COMPACTION_KEEP_RECENT=8

ATHENA_EMBEDDINGS_ENABLED=true
ATHENA_EMBEDDING_DIMS=256

# ─── Retrieval ranking ──────────────────────────────────────────────────────
# The four signals blended into a recall score. Each is normalised to [0,1]
# across the candidate set, so these weights mean relative importance.
# Tuning these is the highest-leverage change you can make; inspect the effect
# with:  athenacore recall "query" --topic t --explain
ATHENA_RECALL_W_KEYWORD=1.0     # BM25 full-text relevance
ATHENA_RECALL_W_SEMANTIC=1.0    # embedding cosine similarity
ATHENA_RECALL_W_RECENCY=0.6     # exponential decay by age
ATHENA_RECALL_W_SALIENCE=0.4    # per-entry importance

ATHENA_RECALL_MAX_ENTRIES=12
ATHENA_RECALL_CANDIDATES=60     # rows scored before ranking
ATHENA_RECALL_HALF_LIFE_H=72    # hours at which recency halves

# Maximal Marginal Relevance: 1.0 = pure relevance, 0.0 = maximum diversity.
# Lower it when agents keep recalling paraphrases of the same point.
ATHENA_RECALL_MMR_LAMBDA=0.7

ATHENA_RECALL_INCLUDE_ARCHIVED=false

# ─── Orchestration ──────────────────────────────────────────────────────────
ATHENA_MAX_PARALLEL_AGENTS=4

ATHENA_DEBATE_ROUNDS=3
# Cosine similarity between consecutive debate rounds above which positions are
# considered settled and the debate stops early.
ATHENA_DEBATE_CONVERGENCE=0.92

ATHENA_TOOLS_ENABLED=true
ATHENA_MAX_TOOL_CALLS=4

# Network egress is opt-in. Needs: pip install 'athenacore[search]'
ATHENA_WEB_SEARCH_ENABLED=false

# ─── Logging ────────────────────────────────────────────────────────────────
ATHENA_LOG_LEVEL=INFO
ATHENA_LOG_JSON=false
